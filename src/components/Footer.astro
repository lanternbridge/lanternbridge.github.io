---
// Footer component — brand, tagline, service list, copyright
---

<footer>
  <div class="container footer-inner">
    <div class="f-left">
      <div class="f-brand">
        <svg width="26" height="26" viewBox="0 0 32 32" fill="none" aria-hidden="true">
          <path d="M3 21 Q16 6 29 21" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" fill="none"/>
          <path d="M2 21 H30" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/>
          <path d="M16 21 V22.4" stroke="currentColor" stroke-width="1.8"/>
          <rect x="13.6" y="22.2" width="4.8" height="1.6" rx=".8" fill="#c99a3f"/>
          <rect x="11.8" y="23.8" width="8.4" height="7" rx="2.8" fill="#d0442e"/>
          <rect x="13.6" y="30.8" width="4.8" height="1.6" rx=".8" fill="#c99a3f"/>
        </svg>
        Lantern&nbsp;<span class="lb-em">Bridge</span>
      </div>
      <p class="f-tag">
        <span class="txt-en">The trusted bridge between Indonesia and China.</span>
        <span class="txt-id">Jembatan terpercaya antara Indonesia dan Tiongkok.</span>
      </p>
    </div>
    <div class="f-mid">
      <span class="txt-en">Education · Medical Travel · Sourcing · AI Growth</span>
      <span class="txt-id">Pendidikan · Perjalanan Medis · Sourcing · Pertumbuhan AI</span>
    </div>
    <div class="f-right">
      <span>
        <span class="txt-en">Teams in Jakarta and five Chinese industrial hubs</span>
        <span class="txt-id">Tim di Jakarta dan lima kota industri Tiongkok</span>
      </span>
      <span>
        <span class="txt-en">© 2026 Lantern Bridge. All rights reserved.</span>
        <span class="txt-id">© 2026 Lantern Bridge. Hak cipta dilindungi.</span>
      </span>
    </div>
  </div>
</footer>
