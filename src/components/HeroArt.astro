---
// Hero illustration — bridge between Indonesia and China with floating service chips.
---

<div class="hero-card reveal">
  <svg class="bridge-art" viewBox="0 0 560 430" role="img" aria-label="Illustration of a lantern-lit stone bridge connecting Indonesia and China">
    <defs>
      <radialGradient id="lbGlow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#ffd98a" stop-opacity=".55"/>
        <stop offset="45%" stop-color="#ffc36b" stop-opacity=".16"/>
        <stop offset="100%" stop-color="#ffc36b" stop-opacity="0"/>
      </radialGradient>
      <linearGradient id="lbWater" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#10315a"/>
        <stop offset="100%" stop-color="#081d36"/>
      </linearGradient>
      <linearGradient id="lbLantern" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#e2513a"/>
        <stop offset="100%" stop-color="#c23a26"/>
      </linearGradient>
    </defs>
    <g fill="#dfe9f5">
      <circle cx="72" cy="60" r="2" opacity=".5"/><circle cx="146" cy="36" r="1.6" opacity=".65"/>
      <circle cx="212" cy="88" r="1.4" opacity=".4"/><circle cx="352" cy="48" r="1.8" opacity=".6"/>
      <circle cx="424" cy="96" r="1.4" opacity=".45"/><circle cx="492" cy="40" r="2" opacity=".55"/>
      <circle cx="520" cy="124" r="1.5" opacity=".4"/><circle cx="102" cy="128" r="1.5" opacity=".35"/>
      <circle cx="452" cy="156" r="1.6" opacity=".3"/>
    </g>
    <circle cx="280" cy="120" r="120" fill="url(#lbGlow)"/>
    <g>
      <rect x="272" y="86" width="16" height="7" rx="3" fill="#c99a3f"/>
      <rect x="257" y="93" width="46" height="52" rx="20" fill="url(#lbLantern)"/>
      <path d="M268 95 Q263 119 268 143 M292 95 Q297 119 292 143" stroke="#8f2415" stroke-width="2" fill="none" opacity=".55"/>
      <rect x="270" y="145" width="20" height="7" rx="3" fill="#c99a3f"/>
      <path d="M280 152 V172" stroke="#e5b95c" stroke-width="3" stroke-linecap="round"/>
      <circle cx="280" cy="177" r="4" fill="#e5b95c"/>
    </g>
    <rect x="10" y="250" width="58" height="86" fill="#16385f"/>
    <rect x="492" y="250" width="58" height="86" fill="#16385f"/>
    <g stroke="#dfe9f5" fill="none" stroke-linecap="round">
      <path d="M84 336 Q280 176 476 336" stroke-width="8" opacity=".92"/>
      <path d="M36 250 H524" stroke-width="6"/>
      <path d="M46 229 H514" stroke-width="2.5" opacity=".55"/>
      <path d="M62 250 V229 M94 250 V229 M126 250 V229 M158 250 V229 M190 250 V229 M222 250 V229 M254 250 V229 M286 250 V229 M318 250 V229 M350 250 V229 M382 250 V229 M414 250 V229 M446 250 V229 M478 250 V229 M502 250 V229" stroke-width="2.5" opacity=".55"/>
    </g>
    <g>
      <path d="M48 250 V194" stroke="#dfe9f5" stroke-width="3" stroke-linecap="round"/>
      <circle cx="70" cy="203" r="14" fill="#f4f7fb"/>
      <path d="M56 203 a14 14 0 0 1 28 0 Z" fill="#ce1126"/>
      <path d="M512 250 V194" stroke="#dfe9f5" stroke-width="3" stroke-linecap="round"/>
      <circle cx="490" cy="203" r="14" fill="#de2910"/>
      <text x="490" y="208.5" text-anchor="middle" font-family="Arial, Helvetica, sans-serif" font-size="14" fill="#ffde00" aria-hidden="true">★</text>
    </g>
    <rect x="0" y="344" width="560" height="86" fill="url(#lbWater)"/>
    <ellipse cx="280" cy="352" rx="64" ry="9" fill="#ffd98a" opacity=".16"/>
    <g stroke="#9fc0e8" stroke-width="2" fill="none" opacity=".3" stroke-linecap="round">
      <path d="M34 368 q17 -8 34 0 t34 0 t34 0 t34 0 t34 0 t34 0 t34 0 t34 0 t34 0 t34 0 t34 0 t34 0 t34 0"/>
      <path d="M86 394 q17 -8 34 0 t34 0 t34 0 t34 0 t34 0 t34 0 t34 0 t34 0 t34 0 t34 0 t34 0"/>
      <path d="M52 416 q17 -8 34 0 t34 0 t34 0 t34 0 t34 0 t34 0 t34 0 t34 0 t34 0 t34 0 t34 0"/>
    </g>
    <g font-family="Inter, Arial, sans-serif" text-anchor="middle" fill="#c7d6ea" font-size="13" font-weight="700" letter-spacing="2.5">
      <text x="120" y="391">INDONESIA</text>
      <text x="442" y="391">CHINA 中国</text>
    </g>
  </svg>
  <div class="chip c1"><span class="dot"></span><span class="txt-en">Education</span><span class="txt-id">Pendidikan</span></div>
  <div class="chip c2"><span class="dot"></span><span class="txt-en">Sourcing</span><span class="txt-id">Sourcing</span></div>
  <div class="chip c3"><span class="dot"></span><span class="txt-en">Medical</span><span class="txt-id">Medis</span></div>
  <div class="chip c4"><span class="dot"></span><span class="txt-en">AI Growth</span><span class="txt-id">AI</span></div>
</div>

<style>
  .hero-card { position: relative; border-radius: var(--radius-lg); overflow: hidden; border: 1px solid rgba(255,255,255,.08);
    background: linear-gradient(160deg, #0e2c4d, #081d36); box-shadow: var(--shadow-lg); }
  .bridge-art { display: block; width: 100%; height: auto; }
  @keyframes floaty { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-7px); } }
  .chip { position: absolute; display: inline-flex; align-items: center; gap: 8px; z-index: 2;
    background: rgba(255,255,255,.95); color: var(--navy); font-size: 12.5px; font-weight: 700;
    padding: 9px 14px; border-radius: 999px; box-shadow: 0 8px 24px rgba(4,15,28,.35); white-space: nowrap; }
  .chip .dot { width: 6px; height: 6px; background: var(--emerald); border-radius: 50%; flex: none; }
  .c1 { top: 6%; left: 4%; animation: floaty 6s ease-in-out infinite; }
  .c2 { top: 12%; right: 4%; animation: floaty 7s ease-in-out .8s infinite; }
  .c3 { top: 66%; left: 4%; animation: floaty 6.5s ease-in-out .4s infinite; }
  .c4 { top: 60%; right: 4%; animation: floaty 7.5s ease-in-out 1.2s infinite; }
  [data-theme="dark"] .chip { background: rgba(17,32,47,.95); color: var(--ink); }
</style>
