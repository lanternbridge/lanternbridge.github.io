---
interface Props {
  titleEn: string;
  titleId: string;
}
const { titleEn, titleId } = Astro.props;
---

<div class="proof-block reveal">
  <div class="proof-label">
    <h3>
      <span class="txt-en">{titleEn}</span>
      <span class="txt-id">{titleId}</span>
    </h3>
  </div>
  <slot />
</div>

<style>
  .proof-block { margin-top: 58px; }
  .proof-block:first-child { margin-top: 0; }
  .proof-label { display: flex; align-items: center; gap: 16px; margin-bottom: 22px; }
  .proof-label h3 { font-size: 22px; color: var(--navy); font-weight: 600; white-space: nowrap; }
  .proof-label:after { content: ""; flex: 1; height: 1px; background: var(--line); }
</style>
