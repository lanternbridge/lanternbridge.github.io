---
interface Service {
  id: string;
  slug: string;
  num: string;
  icon: 'graduation' | 'medical' | 'factory' | 'ai';
  category: { en: string; id: string };
  title: { en: string; id: string };
  description: { en: string; id: string };
  bullets: { en: string; id: string }[];
}

interface Props {
  service: Service;
  showLink?: boolean;
}
const { service, showLink = true } = Astro.props;
---

<article class="service reveal">
  <div class="num">
    <span class="txt-en">{service.num} — {service.category.en}</span>
    <span class="txt-id">{service.num} — {service.category.id}</span>
  </div>

  <div class="icon-box" aria-hidden="true">
    {service.icon === 'graduation' && (
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4 2.5 8.5 12 13l9.5-4.5L12 4Z"/><path d="M6 10.8V15c0 1.7 2.7 3 6 3s6-1.3 6-3v-4.2"/><path d="M21.5 8.5v5"/></svg>
    )}
    {service.icon === 'medical' && (
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3.5" y="3.5" width="17" height="17" rx="5"/><path d="M12 8v8M8 12h8"/></svg>
    )}
    {service.icon === 'factory' && (
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"/><path d="M5 21V9l6-3.5V21"/><path d="M11 21V11l8 4v6"/><path d="M7.8 13v1.5M7.8 17v1.5M15.2 16v1.5"/></svg>
    )}
    {service.icon === 'ai' && (
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3.2"/><path d="M12 2.5v3M12 18.5v3M2.5 12h3M18.5 12h3M5.3 5.3l2.1 2.1M16.6 16.6l2.1 2.1M5.3 18.7l2.1-2.1M16.6 7.4l2.1-2.1"/></svg>
    )}
  </div>

  <h3>
    <span class="txt-en">{service.title.en}</span>
    <span class="txt-id">{service.title.id}</span>
  </h3>

  <p>
    <span class="txt-en">{service.description.en}</span>
    <span class="txt-id">{service.description.id}</span>
  </p>

  <ul>
    {service.bullets.map(b => (
      <li>
        <span class="txt-en">{b.en}</span>
        <span class="txt-id">{b.id}</span>
      </li>
    ))}
  </ul>

  {showLink && (
    <a class="service-link" href={`/services/${service.slug}/`}>
      <span class="txt-en">Learn more →</span>
      <span class="txt-id">Pelajari lebih lanjut →</span>
    </a>
  )}
</article>

<style>
  .service {
    position: relative;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 28px 24px;
    overflow: hidden;
    transition: transform .28s ease, box-shadow .28s ease, border-color .28s ease;
    display: flex;
    flex-direction: column;
  }
  .service:before {
    content: ""; position: absolute; top: 0; left: 0; right: 0; height: 3px;
    background: linear-gradient(90deg, var(--lantern), var(--navy));
    transform: scaleX(0); transform-origin: left; transition: transform .35s ease;
  }
  .service:hover { transform: translateY(-6px); box-shadow: var(--shadow); border-color: var(--line-strong); }
  .service:hover:before { transform: scaleX(1); }
  .num { font-size: 12px; font-weight: 800; letter-spacing: .14em; color: var(--emerald-dark); text-transform: uppercase; }
  .icon-box { width: 46px; height: 46px; border-radius: 12px; background: var(--emerald-tint); display: grid; place-items: center; margin: 18px 0 16px; color: var(--emerald-dark); }
  .service h3 { font-size: 21px; color: var(--navy); font-weight: 600; margin-bottom: 10px; }
  .service > p { color: var(--muted); font-size: 14px; }
  .service ul { list-style: none; margin-top: 16px; }
  .service li { margin: 8px 0; font-size: 14px; color: var(--ink-soft); }
  .service li:before { content: "→"; color: var(--emerald-dark); font-weight: 700; margin-right: 8px; }
  .service-link {
    margin-top: auto; padding-top: 16px;
    color: var(--emerald-dark); font-weight: 700; font-size: 14px;
    text-decoration: none;
  }
  .service-link:hover { text-decoration: underline; }
  [data-theme="dark"] .service { background: #11202f; }
  [data-theme="dark"] .icon-box { background: rgba(52,196,142,.12); }
</style>
