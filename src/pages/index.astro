---
import Layout from '../layouts/Layout.astro';
import HeroArt from '../components/HeroArt.astro';
import ServiceCard from '../components/ServiceCard.astro';
import Testimonial from '../components/Testimonial.astro';
import ProcessStep from '../components/ProcessStep.astro';
import ProofBlock from '../components/ProofBlock.astro';
import CTASection from '../components/CTASection.astro';
import { services } from '../data/services.js';
import { testimonials } from '../data/testimonials.js';
import { universities, hubs, stats } from '../data/proof.js';
import { process } from '../data/process.js';
---

<Layout
  title="Lantern Bridge | Indonesia–China Education, Medical, Sourcing & AI Consulting"
  description="The trusted bridge between Indonesia and China — university admissions, medical travel coordination, factory sourcing, and AI-powered growth, delivered by a bilingual, PhD-led team on the ground in China."
>

  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <div class="hero-grid">
        <div class="reveal">
          <h1>
            <span class="txt-en">The trusted <em class="hl">bridge</em> between Indonesia &amp; China.</span>
            <span class="txt-id">Jembatan <em class="hl">terpercaya</em> antara Indonesia dan Tiongkok.</span>
          </h1>
          <p class="lead">
            <span class="txt-en">Lantern Bridge helps students, importers and growing businesses move across the border with confidence — from university admissions and factory sourcing to on-the-ground business and medical support. You bring the goal. We provide the people, the language, and the local reach on the ground in China.</span>
            <span class="txt-id">Lantern Bridge membantu mahasiswa, importir, dan pelaku bisnis yang berkembang melintasi batas dengan percaya diri — dari pendaftaran universitas dan sourcing pabrik hingga pendampingan bisnis dan medis langsung di lapangan. Anda menentukan tujuannya. Kami menyediakan tim, bahasa, dan jangkauan lokal di Tiongkok.</span>
          </p>
          <div class="actions">
            <a class="btn btn-primary" href="/services/">
              <span class="txt-en">Explore our Services</span>
              <span class="txt-id">Jelajahi Layanan Kami</span>
            </a>
            <a class="btn btn-whatsapp" href="https://wa.me/6289669367988" target="_blank" rel="noopener noreferrer">
              <span class="txt-en">Chat on WhatsApp</span>
              <span class="txt-id">Chat via WhatsApp</span>
            </a>
          </div>
          <p class="trust-bar">
            <span class="txt-en">Trusted by Indonesian families, importers and international students</span>
            <span class="txt-id">Dipercaya oleh keluarga, importir, dan mahasiswa internasional Indonesia</span>
          </p>
          <ul class="assure">
            <li><span class="txt-en">Free first consultation</span><span class="txt-id">Konsultasi pertama gratis</span></li>
            <li><span class="txt-en">Reply within one business day</span><span class="txt-id">Balasan dalam satu hari kerja</span></li>
            <li><span class="txt-en">Support in Bahasa Indonesia</span><span class="txt-id">Pendampingan Bahasa Indonesia</span></li>
          </ul>
        </div>

        <HeroArt />
      </div>

      <div class="stats reveal">
        {stats.map(s => (
          <div class="stat">
            <strong>{s.value}</strong>
            <span>
              <span class="txt-en">{s.label.en}</span>
              <span class="txt-id">{s.label.id}</span>
            </span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Services preview -->
  <section class="band">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <div class="kicker">
            <span class="txt-en">What we do</span>
            <span class="txt-id">Apa yang kami lakukan</span>
          </div>
          <h2>
            <span class="txt-en">Four ways across the bridge.</span>
            <span class="txt-id">Empat jalur penyeberangan.</span>
          </h2>
        </div>
        <p>
          <span class="txt-en">Each service is delivered end-to-end by our own team and verified partners — in Bahasa Indonesia, English or Mandarin.</span>
          <span class="txt-id">Setiap layanan ditangani tuntas oleh tim kami dan mitra terverifikasi — dalam Bahasa Indonesia, Inggris, atau Mandarin.</span>
        </p>
      </div>

      <div class="services">
        {services.map(service => <ServiceCard service={service} />)}
      </div>
    </div>
  </section>

  <!-- Proof preview -->
  <section>
    <div class="container">
      <div class="section-head reveal">
        <div>
          <div class="kicker">
            <span class="txt-en">Track record</span>
            <span class="txt-id">Rekam jejak</span>
          </div>
          <h2>
            <span class="txt-en">Proof, not promises.</span>
            <span class="txt-id">Bukti, bukan janji.</span>
          </h2>
        </div>
      </div>

      <ProofBlock titleEn="Universities our students attend" titleId="Universitas tempat mahasiswa kami belajar">
        <div class="unis">
          {universities.slice(0, 6).map(u => (
            <div class="uni">
              <span class="uni-cn">{u.code}</span>
              <span class="uni-name">{u.name}</span>
            </div>
          ))}
        </div>
        <p class="foot-note">
          <span class="txt-en">A selection from our 20+ university network — spanning admissions, scholarships and joint programs.</span>
          <span class="txt-id">Sebagian dari 20+ jaringan universitas kami — mencakup pendaftaran, beasiswa, dan program bersama.</span>
        </p>
      </ProofBlock>

      <ProofBlock titleEn="What our clients say" titleId="Kata klien kami">
        <div class="quotes">
          {testimonials.map(t => <Testimonial testimonial={t} />)}
        </div>
      </ProofBlock>
    </div>
  </section>

  <!-- Process preview -->
  <section class="band">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <div class="kicker">
            <span class="txt-en">How we work</span>
            <span class="txt-id">Cara kami bekerja</span>
          </div>
          <h2>
            <span class="txt-en">A crossing made certain.</span>
            <span class="txt-id">Penyeberangan yang pasti.</span>
          </h2>
        </div>
      </div>

      <div class="process">
        {process.map(step => <ProcessStep step={step} />)}
      </div>
    </div>
  </section>

  <CTASection />

</Layout>

<style>
  .hero { padding: 130px 0 90px; }
  .hero-grid { display: grid; grid-template-columns: 1.05fr .95fr; gap: 56px; align-items: center; }
  .lead { font-size: 17.5px; color: var(--muted); max-width: 600px; }
  .actions { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 30px; }
  .trust-bar { margin-top: 24px; font-size: 14px; font-weight: 600; color: var(--ink-soft); display: flex; align-items: center; gap: 10px; }
  .trust-bar:before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: var(--emerald); box-shadow: 0 0 0 4px rgba(14,124,91,.15); flex: none; }
  .assure { display: flex; flex-wrap: wrap; gap: 10px 24px; margin-top: 22px; padding: 0; list-style: none; }
  .assure li { display: flex; align-items: center; gap: 8px; font-size: 14px; font-weight: 600; color: var(--ink-soft); }
  .assure li:before { content: "✓"; color: var(--emerald-dark); font-weight: 700; }
  .stats { display: grid; grid-template-columns: repeat(4, 1fr); border: 1px solid var(--line); border-radius: var(--radius-lg); background: #fff; box-shadow: var(--shadow-sm); overflow: hidden; margin-top: 66px; }
  .stat { padding: 26px 24px; border-left: 1px solid var(--line); }
  .stat:first-child { border-left: 0; }
  .stat strong { display: block; font-size: 34px; line-height: 1.1; color: var(--navy); font-weight: 600; margin-bottom: 5px; }
  .stat span { font-size: 13.5px; color: var(--muted); }
  .services { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; }
  .process { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .unis { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  .uni { display: flex; align-items: center; gap: 14px; background: #fff; border: 1px solid var(--line); border-radius: 14px; padding: 14px 16px; min-height: 72px; }
  .uni-cn { width: 44px; height: 44px; flex: none; border-radius: 10px; background: var(--navy); color: #fff; display: grid; place-items: center; font-size: 15px; font-weight: 600; font-family: var(--font-head); }
  .uni-name { font-size: 13.5px; font-weight: 600; color: var(--ink); line-height: 1.3; }
  .foot-note { font-size: 13px; color: var(--muted); margin-top: 16px; }
  .quotes { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }

  [data-theme="dark"] .stat, [data-theme="dark"] .uni { background: #11202f; }
  [data-theme="dark"] .stats { background: #11202f; }

  @media (max-width: 1020px) {
    .hero-grid { grid-template-columns: 1fr; gap: 46px; }
    .services { grid-template-columns: 1fr 1fr; }
    .process { grid-template-columns: repeat(2, 1fr); }
    .unis { grid-template-columns: repeat(2, 1fr); }
    .quotes { grid-template-columns: 1fr; }
    .stats { grid-template-columns: 1fr 1fr; }
    .stat:nth-child(odd) { border-left: 0; }
    .stat:nth-child(n+3) { border-top: 1px solid var(--line); }
  }
  @media (max-width: 760px) {
    .hero { padding: 118px 0 64px; }
    .services, .process, .unis, .quotes { grid-template-columns: 1fr; }
    .stats { grid-template-columns: 1fr; }
    .stat { border-left: 0; border-top: 1px solid var(--line); }
    .stat:first-child { border-top: 0; }
  }
</style>
