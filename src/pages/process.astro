---
import Layout from '../layouts/Layout.astro';
import ProcessStep from '../components/ProcessStep.astro';
import CTASection from '../components/CTASection.astro';
import { process, pledge } from '../data/process.js';
---

<Layout
  title="How We Work | Lantern Bridge — A Crossing Made Certain"
  description="Four steps, one promise: you always know what happens next — and what it costs. Written scope and pricing before any commitment."
>

  <section class="page-head">
    <div class="container">
      <div class="kicker">
        <span class="txt-en">How we work</span>
        <span class="txt-id">Cara kami bekerja</span>
      </div>
      <h1>
        <span class="txt-en">A crossing made certain.</span>
        <span class="txt-id">Penyeberangan yang pasti.</span>
      </h1>
      <p class="lead">
        <span class="txt-en">Four steps, one promise: you always know what happens next — and what it costs.</span>
        <span class="txt-id">Empat langkah, satu janji: Anda selalu tahu langkah berikutnya — dan berapa biayanya.</span>
      </p>
    </div>
  </section>

  <section class="band">
    <div class="container">
      <div class="process">
        {process.map(step => <ProcessStep step={step} />)}
      </div>

      <div class="pledge reveal">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6l8-3Z"/><path d="M9 12l2 2 4-4"/></svg>
        <span>
          <span class="txt-en" set:html={pledge.en} />
          <span class="txt-id" set:html={pledge.id} />
        </span>
      </div>
    </div>
  </section>

  <CTASection />

</Layout>

<style>
  .page-head { padding: 130px 0 40px; }
  .lead { font-size: 17px; color: var(--muted); max-width: 640px; margin-top: 12px; }
  .process { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .pledge { margin-top: 26px; display: flex; gap: 12px; align-items: flex-start; background: var(--emerald-tint); border: 1px solid #cfe8dd; border-radius: 14px; padding: 16px 18px; font-size: 14px; color: var(--ink-soft); font-weight: 500; }
  .pledge svg { flex: none; color: var(--emerald-dark); margin-top: 2px; }
  [data-theme="dark"] .pledge { background: rgba(52,196,142,.1); border-color: rgba(52,196,142,.2); }
  @media (max-width: 1020px) { .process { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 760px) {
    .page-head { padding: 118px 0 30px; }
    .process { grid-template-columns: 1fr; }
  }
</style>
